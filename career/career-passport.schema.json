          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "claim",
          "source_ids",
          "verification"
        ],
        "additionalProperties": false
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
