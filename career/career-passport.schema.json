        "required": [
          "id",
          "name",
          "verification"
        ],
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "claim": {
            "type": "string"
          },
          "project_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_type": {
            "type": "string"
          },
          "verification": {
            "enum": [
              "reported",
              "needs_details",
              "owner_verified",
              "inferred"
