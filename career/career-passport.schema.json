            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "verification": {
            "enum": [
              "reported",
              "needs_details",
              "owner_verified",
              "inferred"
            ]
          },
          "visibility": {
            "enum": [
              "private",
              "approved_public",
              "sanitized"
            ]
