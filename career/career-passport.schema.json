          "verification": {
            "enum": [
              "reported",
              "needs_details",
              "owner_verified",
              "inferred"
            ]
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_strength": {
            "enum": [
              "profile_listed_only",
              "project_reported"
            ]
          }
