{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Upwork": {
    "Endpoint": "https://mcp.upwork.com/mcp",
    "InteractiveSignIn": false,
    "CallTimeout": "00:01:00",
    "TreatDriftAsError": false
  },
  "JobScout": {
    "SearchProfiles": {
      "upwork-recommended": {
        "SmartSearch": {
          "Mode": "MostRecent",
          "Filters": { "VerifiedPaymentOnly": true }
        },
        "MaxPages": 3,
        "MaxLookback": "2.00:00:00",
        "Overlap": "01:00:00"
      },
      "upwork-mcp": {
        "Search": {
          "Title": "MCP",
          "Sort": "Recency",
          "IncludeFullDetails": true,
          "Filters": { "VerifiedPaymentOnly": true }
        },
        "MaxPages": 3,
        "MaxLookback": "2.00:00:00",
        "Overlap": "01:00:00"
      }
    }
  }
}
